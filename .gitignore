# 로컬 설정. 주소와 경로가 들어 있어 저장소에 올리면 안 된다.
config/설정.yaml

# 빈 양식 config/설정양식.yaml 은 이 목록에 넣지 않는다. 저장소에 올라가도 된다.

# 환경 비밀 파일
.env
.env.*

# 컴퓨터마다 다른 로컬 파일
*.local

# 운영체제 찌꺼기
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# 의존성 폴더
node_modules/
.venv/
venv/
__pycache__/

# 실행 중에 생기는 기록. 저장소에 올리지 않는다.
*.log
상태.json
최근.json

# 비밀 파일
*.pem
*.key
secrets/
credentials.json
*비밀*
